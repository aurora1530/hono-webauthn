FROM node:22.23.4-bookworm AS base
WORKDIR /app

FROM base AS deps
COPY package*.json ./

RUN npm ci

FROM deps AS builder
COPY . .
ENV NODE_ENV=production

RUN npx prisma generate

RUN npm run build

FROM base AS production-deps
COPY package*.json ./
# Exclude development roots before resolving Prisma's optional CLI/TypeScript peers.
RUN npm pkg delete devDependencies scripts && \
    npm ci --omit=dev --omit=peer --ignore-scripts
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma

FROM base AS runner
ENV NODE_ENV=production
WORKDIR /app

# lightweight init to handle PID1 signal forwarding/zombie reaping
RUN apt-get update && \
    apt-get install -y --no-install-recommends dumb-init && \
    rm -rf /var/lib/apt/lists/*

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 hono

COPY --from=production-deps --chown=hono:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=hono:nodejs /app/dist ./dist
COPY --from=builder --chown=hono:nodejs /app/prisma ./prisma
COPY --from=builder --chown=hono:nodejs /app/public ./public
COPY --from=builder --chown=hono:nodejs /app/aaguid.json ./aaguid.json

ENTRYPOINT ["dumb-init", "--"]
USER hono
EXPOSE 3000

CMD ["node", "dist/index.js"]
