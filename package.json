{
  "name": "hono-webauthn",
  "type": "module",
  "engines": {
    "node": ">=22.14.x"
  },
  "scripts": {
    "typecheck": "npm-run-all typecheck:server typecheck:client",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "test:registration": "node --import tsx --experimental-test-module-mocks --test tests/registration.test.mjs",
    "test:passkey-deletion": "node --import tsx --experimental-test-module-mocks --test tests/passkey-deletion.test.mjs",
    "test:redirect": "node --import tsx --experimental-test-module-mocks --test tests/redirect.test.mjs",
    "test:rate-limit": "node --import tsx --experimental-test-module-mocks --test tests/rate-limit.test.mjs",
    "test:login-session": "node --import tsx --experimental-test-module-mocks --test tests/login-session.test.mjs",
    "test:resource-limits": "tsx --tsconfig tsconfig.server.json --experimental-test-module-mocks --test tests/resource-limits.test.mjs",
    "test:dependency-compatibility": "node --test tests/dependency-compatibility.test.mjs",
    "test:logout": "tsx --tsconfig tsconfig.server.json --experimental-test-module-mocks --test tests/logout.test.mjs",
    "build": "npm-run-all build:db build:server build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:db": "prisma generate",
    "build:client": "node scripts/bundler.js",
    "deploy:migrate": "prisma migrate deploy",
    "watch:client": "node scripts/bundler.js --watch",
    "dev": "npm-run-all --parallel watch:client dev:server",
    "dev:server": "dotenvx run -f .env -- tsx watch --tsconfig tsconfig.server.json src/index.tsx",
    "update:aaguid": "tsx scripts/aaguid/update.ts && ./scripts/aaguid/commit.sh",
    "biome:check": "biome lint .",
    "biome:format": "biome format --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@prisma/client": "^6.4.1",
    "@simplewebauthn/server": "^13.3.3",
    "debounce": "^3.0.0",
    "hono": "^4.13.13",
    "redis": "^5.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.6",
    "@dotenvx/dotenvx": "^1.51.1",
    "@types/node": "^20.11.17",
    "esbuild": "0.25.12",
    "glob": "^11.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "npm-run-all": "^4.1.5",
    "prisma": "^6.4.1",
    "tsx": "^4.7.1",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,css}": "biome check --write --no-errors-on-unmatched"
  }
}
